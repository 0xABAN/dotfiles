{
  "lastChangelogVersion": "1.0.0",
  "theme": "everforest-dark-hard",
  "themes": ["themes"],
  "quietStartup": true,
  "defaultTools": [
    "+codemode"
  ],
  "defaultProvider": "xai",
  "defaultModel": "grok-4.6",
  "defaultThinkingLevel": "xhigh",
  "enabledModels": [
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra"
  ],
  "packages": [
    "npm:@tintinweb/pi-subagents",
    "npm:@juicesharp/rpiv-ask-user-question",
    {
      "source": "npm:pi-goal",
      "skills": []
    },
    "npm:pi-intercom",
    "https://github.com/nicobailon/pi-powerline-footer@8c9bda10fdfd2822e89334ec85f3da9f8ca49182",
    {
      "source": "npm:@dietrichgebert/ponytail",
      "skills": [
        "ponytail"
      ]
    },
    "https://github.com/nicobailon/pi-rewind-hook",
    "https://github.com/nicobailon/pi-skill-palette",
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-todo",
    "../../dev/pi-extensions/inline-skills",
    "../../dev/pi-extensions/dj",
    "npm:pi-claude-bridge"
  ],
  "powerline": {
    "preset": "default",
    "placement": "below",
    "separator": "chevron",
    "disabledSegments": [
      "extension_statuses",
      "cache_read"
    ],
    "context": {
      "format": "meter"
    },
    "cost": {
      "subscriptionDisplay": "reported-cost"
    },
    "git": {
      "showBranch": true,
      "showStaged": false,
      "showUnstaged": true,
      "showUntracked": false
    },
    "customItems": [
      {
        "id": "mode",
        "statusKey": "agent-mode",
        "position": "left",
        "selfColorize": true,
        "hideWhenMissing": false
      },
      {
        "id": "thinking",
        "statusKey": "agent-thinking",
        "position": "left",
        "selfColorize": true,
        "hideWhenMissing": false
      }
    ],
    "layout": {
      "left": [
        "model",
        "custom:thinking"
      ],
      "right": [
        "cost",
        "context_pct"
      ],
      "secondary": [
        "shell_mode",
        "queue"
      ]
    }
  },
  "skills": [
    "-skills/brand",
    "-skills/test-driven-development",
    "-skills/use-railway",
    "-skills/watch"
  ]
}