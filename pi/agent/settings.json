{
  "lastChangelogVersion": "0.84.2",
  "theme": "osaka-jade",
  "quietStartup": true,
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "xhigh",
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:@tintinweb/pi-subagents",
    "npm:@juicesharp/rpiv-ask-user-question",
    {
      "source": "npm:pi-goal",
      "skills": []
    },
    {
      "source": "https://github.com/ShpetimA/pi-fff",
      "extensions": []
    },
    "npm:pi-intercom",
    "npm:@heyhuynhgiabuu/pi-pretty",
    "https://github.com/nicobailon/pi-powerline-footer@8c9bda10fdfd2822e89334ec85f3da9f8ca49182",
    {
      "source": "npm:@dietrichgebert/ponytail",
      "skills": [
        "ponytail"
      ]
    },
    "https://github.com/nicobailon/pi-rewind-hook",
    "https://github.com/nicobailon/pi-skill-palette",
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-todo",
    "../../dev/pi-extensions/inline-skills",
    "../../dev/pi-extensions/dj",
    "npm:pi-jev-router@0.4.0"
  ],
  "jevRouter": {
    "options": {
      "openai-codex/gpt-6-astra": {
        "description": "Architecture, difficult debugging, and complex reasoning.",
        "thinking": "xhigh"
      },
      "openai-codex/gpt-5.6-luna": {
        "description": "Small fixes, tests, and routine implementation.",
        "thinking": "xhigh"
      }
    },
    "fallback": "openai-codex/gpt-6-astra"
  },
  "powerline": {
    "preset": "default",
    "placement": "below",
    "separator": "chevron",
    "disabledSegments": [
      "extension_statuses",
      "cache_read"
    ],
    "context": {
      "format": "meter"
    },
    "cost": {
      "subscriptionDisplay": "reported-cost"
    },
    "git": {
      "showBranch": true,
      "showStaged": false,
      "showUnstaged": true,
      "showUntracked": false
    },
    "customItems": [
      {
        "id": "mode",
        "statusKey": "agent-mode",
        "position": "left",
        "selfColorize": true,
        "hideWhenMissing": false
      },
      {
        "id": "thinking",
        "statusKey": "agent-thinking",
        "position": "left",
        "selfColorize": true,
        "hideWhenMissing": false
      }
    ],
    "layout": {
      "left": ["model", "custom:thinking"],
      "right": ["cost", "context_pct"],
      "secondary": ["shell_mode", "queue"]
    }
  },
  "skills": [
    "-skills/brand",
    "-skills/brief",
    "-skills/test-driven-development",
    "-skills/use-railway",
    "-skills/watch"
  ],
  "enabledModels": [
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra"
  ]
}
