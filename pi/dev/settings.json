{
  "defaultProvider": "claude-bridge",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "medium",
  "theme": "everforest-dark-hard",
  "themes": [
    "~/dev/configs/pi/agent/themes"
  ],
  "packages": [
    "../../dev/pi-extensions/claude-bridge",
    {
      "source": "npm:pi-goal",
      "skills": []
    },
    {
      "source": "npm:@dietrichgebert/ponytail",
      "skills": [
        "ponytail"
      ]
    },
    "https://github.com/nicobailon/pi-skill-palette",
    "../../dev/pi-extensions",
    "../../dev/pi-extensions/powerline",
    "../../dev/pi-extensions/todo",
    "../../dev/pi-extensions/ask-user-question",
    "../../dev/pi-extensions/intercom"
  ],
  "quietStartup": true,
  "defaultTools": [
    "+codemode"
  ],
  "enabledModels": [
    "claude-bridge/claude-opus-5-5"
  ],
  "powerline": {
    "preset": "default",
    "placement": "below",
    "separator": "chevron",
    "disabledSegments": [
      "extension_statuses",
      "cache_read"
    ],
    "context": {
      "format": "meter"
    },
    "cost": {
      "subscriptionDisplay": "reported-cost"
    },
    "git": {
      "showBranch": true,
      "showStaged": false,
      "showUnstaged": true,
      "showUntracked": false
    },
    "customItems": [
      {
        "id": "mode",
        "statusKey": "agent-mode",
        "position": "left",
        "selfColorize": true,
        "hideWhenMissing": false
      },
      {
        "id": "thinking",
        "statusKey": "agent-thinking",
        "position": "left",
        "selfColorize": true,
        "hideWhenMissing": false
      }
    ],
    "layout": {
      "left": [
        "model",
        "custom:thinking"
      ],
      "right": [
        "cost",
        "context_pct"
      ],
      "secondary": [
        "shell_mode",
        "queue"
      ]
    }
  }
}
